#!name=Locket Gold Full Effects
#!desc=Mở khóa Locket Gold + toàn bộ hiệu ứng (30s video, camera roll, filter, badge...)
#!author=Custom
#!version=2026.11

[General]
user-agent = Locket/1.0.0 (iPhone; iOS 18.0; Scale/3.00)

[Script]
# 1. Fake RevenueCat (Gold subscription)
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Module-Shadowrocket-NMS/Locket%20Gold/locketfix8.js, requires-body=true, max-size=-1, timeout=60

# 2. Xóa header ETag để luôn nhận dữ liệu mới
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Module-Shadowrocket-NMS/Locket%20Gold/header7.js, timeout=60

# 3. Force Remote Config (toàn bộ hiệu ứng + tính năng Gold)
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/NightmarketServer/Module-Shadowrocket-NMS/refs/heads/main/Module-Shadowrocket-NMS/Locket%20Gold/forceGold4.3.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com